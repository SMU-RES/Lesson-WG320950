{
  "include": ["src", "tests", "scripts"],
  "extraPaths": ["src"],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": ["src"]
    },
    {
      "root": "tests",
      "extraPaths": ["../src"]
    },
    {
      "root": "scripts",
      "extraPaths": ["../src"]
    }
  ],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none"
}
